@{
    Layout = "_LayoutAdmin";
}
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<div class="col-12">
    <div class="card mb-4">
        <div class="card-header bg-primary pb-0">
            <center>
                <strong><h3 class="text-white">List Trainer</h3></strong>
            </center>
            <!-- Button trigger modal -->
        </div>
        <div class="mt-2" style="margin-left: 16px">
            <button type="button" class="btn btn-primary mb-0" data-bs-toggle="modal" data-bs-target="#modalInsert">
                Insert
            </button>
        </div>
        <div class="card-body px-0 pt-0 pb-">
            <div class="table-responsive p-4">
                <table id="employee" class="table align-items-center justify-content-center mb-0" width="100%">
                    <thead>
                        <tr>
                            <th class="text-uppercase text-black-50">No</th>
                            <th class="text-uppercase text-black-50">NIK</th>
                            <th class="text-uppercase text-black-50">First_name</th>
                            <th class="text-uppercase text-black-50">Last_name</th>
                            <th class="text-uppercase text-black-50">Gender</th>
                            <th class="text-uppercase text-black-50">BirthDate</th>
                            <th class="text-uppercase text-black-50">Email</th>
                            <th class="text-uppercase text-black-50">Role</th>
                            <th class="text-uppercase text-black-50">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>


<!-- Modal -->
<div class="modal fade" id="modalInsert" tabindex="-1" aria-labelledby="modalInsert" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="namaHeader">Insert Data</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="formValidation" action="" method="post">
                    <div class="mb-3">
                        <label for="inputNIK" class="form-label">NIK</label>
                        <input type="number" name="nik" class="form-control" id="inputNIK" placeholder="Example: 11111" style="height:36px;font-size:15px; width:100%">
                    </div>
                    <div class="mb-3">
                        <label for="inputFirstName" class="form-label">First Name</label>
                        <input type="text" name="first_name" class="form-control" id="inputFirstName" placeholder="Example: Jhon" style="height:36px;font-size:15px; width:100%">
                    </div>
                    <div class="mb-3">
                        <label for="inputLastName" class="form-label">Last Name</label>
                        <input type="text" name="last_name" class="form-control" id="inputLastName" placeholder="Example: Cena" style="height:36px;font-size:15px; width:100%">
                    </div>
                    <div class="mb-3">
                        <div class="form-group">
                            <label for="pwd">Gender:</label>
                            <select class="form-control" name="gender" id="inputGender">
                                <option value="none" selected disabled> Pilih Gender</option>
                                <option value="0">Male</option>
                                <option value="1">Female</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="inputBirthDate" class="form-label">Birth Date</label>
                        <input type="date" name="BirthDate" class="form-control" id="inputBirthDate" style="height:36px;font-size:15px; width:100%">
                    </div>
                    <div class="mb-3">
                        <label for="inputEmail" class="form-label">Email</label>
                        <input type="text" name="Email" class="form-control" id="inputEmail" placeholder="Example: jhon@example.com" style="height:36px;font-size:15px; width:100%">
                    </div>
                    <div class="mb-3">
                        <label for="inputPassword" class="form-label">Password</label>
                        <input type="password" name="Password" class="form-control" id="inputPassword" placeholder="Example: password" style="height:36px;font-size:15px; width:100%">
                    </div>
                    <div class="mb-3">
                        <div class="form-group">
                            <label for="pwd">Role:</label>
                            <select class="form-control" name="Role" id="inputRole" disabled>
                                <option value="1" selected disabled>Trainer</option>
                            </select>
                        </div>
                    </div>
                        <input type="text" value="true" name="IsActive" class="form-control" id="inputIsActive" hidden>
                    <button type="submit" class="btn btn-success" style="float: right" id="btnSubmit">Submit</button>
                    <button type="submit" class="btn btn-primary" style="float: right" id="btnEdit">Edit</button>
                    <button type="reset" class="btn btn-secondary mr-1" style="float: right" data-bs-dismiss="modal">Close</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script src="~/js/Admin/datatables-employee.js" asp-append-version="true"></script>