@{
    Layout = "_Layout";
}

<!-- About/Services Section Start -->
<section id="services" class="section">
    <div class="container">
        <div class="row" style="margin-bottom: 100px">
            <!-- Start Col -->
            <div class="col-lg-6 col-md-12 pl-0 pt-70 pr-5">
                <div class="business-item-img">
                    <img src="~/Home/img/business/business-img.png" class="img-fluid" alt="" />
                </div>
            </div>
            <!-- End Col -->
            <!-- Start Col -->
            <div class="col-lg-6 col-md-12 pl-4">
                <div class="business-item-info">
                    <h3>Learning Management System</h3>
                    <p class="text-justify mb-3">
                        Perkenalkan, LeMaS (Learning Management System) yaitu sebuah website pembelajaran yang siap pakai. Fitur yang lengkap akan memudahkan proses pembelajaran, mulai dari trainer dan peserta dalam hal memberikan materi, tugas dan mengumpulkan tugas.
                    </p>
                    <a class="btn btn-common" href="Login/Index">Login</a>
                    <a class="btn btn-common" href="Login/Register">Register</a>
                </div>
            </div>
            <!-- End Col -->
        </div>

        <div class="row">
            <!-- Start Col -->
            <div class="col-lg-4 col-md-6 col-xs-12">
                <div class="services-item text-center">
                    <div class="icon">
                        <i class="lni-layers"></i>
                    </div>
                    <h4>Materi dan Tugas</h4>
                    <p> Trainer memberikan materi dan tugas<span style="color: white">.</span></p>
                </div>
            </div>
            <!-- End Col -->
            <!-- Start Col -->
            <div class="col-lg-4 col-md-6 col-xs-12">
                <div class="services-item text-center">
                    <div class="icon">
                        <i class="lni-upload"></i>
                    </div>
                    <h4>Tugas</h4>
                    <p>Peserta mengumpulkan tugas<span style="color: white">....</span></p>
                </div>
            </div>
            <!-- End Col -->
            <!-- Start Col -->
            <div class="col-lg-4 col-md-6 col-xs-12">
                <div class="services-item text-center">
                    <div class="icon">
                        <i class="lni-layers"></i>
                    </div>
                    <h4>Nilai</h4>
                    <p>Peserta mendapatkan nilai</p>
                </div>
            </div>
            <!-- End Col -->
        </div>
    </div>
</section>
<!-- About/Services Section End -->
